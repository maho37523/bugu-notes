.aws/

# Credentials, signing material and real application data must never enter Git.
.env
.env.*
*.jks
*.keystore
*.p12
*.pem
*.key
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
